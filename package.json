{
  "name": "agentmeter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:dashboard": "npm run dev --workspace @agentmeter/dashboard",
    "dev:gateway": "npm run dev --workspace @agentmeter/gateway",
    "dev:simulator": "npm run dev --workspace @agentmeter/provider-simulator",
    "dev:worker": "npm run dev --workspace @agentmeter/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "test:redis": "vitest run tests/redis.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "prisma": "6.12.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "5.0.1"
  }
}
